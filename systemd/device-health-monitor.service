[Unit]
Description=Embedded Linux Device Health Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/device-health-monitor /etc/device-health-monitor/health_monitor.json
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
